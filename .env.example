# ==============================================================================
# SYNCSPACE (FS-02) ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in backend/ or root for local development.
# Do NOT commit actual secrets to version control.
# ==============================================================================

# NODE ENVIRONMENT
NODE_ENV=development
PORT=4000

# DATABASE (Neon PostgreSQL in Production, Docker Postgres locally)
# DATABASE_URL: Pooled connection string used at runtime by backend
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/syncspace?schema=public"
# DIRECT_URL: Direct, non-pooled connection string used for Prisma migrations and CLI
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/syncspace?schema=public"

# REDIS (External Redis-compatible service in Production, Docker Redis locally)
REDIS_URL="redis://localhost:6379"

# AUTHENTICATION SECRETS (Generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET="syncspace-dev-access-secret-32-chars-min-change-me"
JWT_REFRESH_SECRET="syncspace-dev-refresh-secret-32-chars-min-change-me"
COLLAB_TICKET_SECRET="syncspace-dev-collab-ticket-secret-change-me"

# TOKEN LIFESPANS
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS & WEBSOCKET ORIGINS
FRONTEND_ORIGIN="http://localhost:5173"
WS_ALLOWED_ORIGIN="http://localhost:5173"

# FRONTEND CLIENT ENVIRONMENT VARIABLES (Vite prefixes with VITE_)
# For local development:
VITE_API_URL="http://localhost:4000"
VITE_WS_URL="ws://localhost:4000/collaboration"
